rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // 1. Core Primitives
    function isSignedIn() {
      return request.auth != null;
    }
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'lorranogab@gmail.com' ||
        request.auth.token.email == 'cbmpr.leilao@gmail.com' ||
        request.auth.uid == 'ohL34Vl1pFRAWcNXbc91EF2V0hP2'
      );
    }
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128;
    }

    // 2. Collection Rules
    // Fleet Vehicles: Read allowed for all inspectors to prevent yard data loss offline/in field.
    // Modifications require authentication.
    match /vehicles/{vehicleId} {
      allow read: if true;
      allow create: if isSignedIn() && isValidId(vehicleId);
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    // Vehicle Inspections: Read allowed for all inspectors to view history and previous day laudos.
    // Creation and updates require authentication.
    match /inspections/{inspectionId} {
      allow read: if true;
      allow create: if isSignedIn() && isValidId(inspectionId);
      allow update: if isSignedIn() && isValidId(inspectionId);
      allow delete: if isSignedIn();
    }
  }
}
