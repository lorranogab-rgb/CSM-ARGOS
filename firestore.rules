rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // 1. Core Primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && (
        request.auth.token.email_verified == true || 
        request.auth.token.email in ['lorranogab@gmail.com', 'cbmpr.leilao@gmail.com']
      );
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.email in ['lorranogab@gmail.com', 'cbmpr.leilao@gmail.com'];
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    // 2. Validation Blueprints
    function isValidVehicle(data) {
      return data.keys().hasAll(['placa', 'modelo', 'uploadedAt', 'uploadedBy'])
        && data.placa is string && data.placa.size() <= 128
        && data.modelo is string && data.modelo.size() <= 512
        && (data.uploadedBy == request.auth.uid || isAdmin());
    }

    function isValidInspection(data) {
      return data.keys().hasAll(['placa', 'modelo', 'nota', 'class', 'data', 'fullData', 'inspectedAt', 'inspectedBy'])
        && data.placa is string && data.placa.size() <= 128
        && data.modelo is string && data.modelo.size() <= 512
        && data.nota is number
        && data.fullData is map
        && (data.inspectedBy == request.auth.uid || isAdmin());
    }

    // 3. Collection Rules
    match /vehicles/{vehicleId} {
      allow get: if isSignedIn() && (isAdmin() || resource.data.uploadedBy == request.auth.uid);
      allow list: if isSignedIn() && (isAdmin() || resource.data.uploadedBy == request.auth.uid);
      
      allow create: if isVerified() 
                    && isValidId(vehicleId)
                    && isValidVehicle(incoming())
                    && incoming().uploadedAt == request.time;
                    
      allow update: if isAdmin();
      
      allow delete: if isAdmin();
    }

    match /inspections/{inspectionId} {
      allow get: if isSignedIn() && (isAdmin() || resource.data.inspectedBy == request.auth.uid);
      allow list: if isSignedIn() && (isAdmin() || resource.data.inspectedBy == request.auth.uid);
      
      allow create: if isVerified()
                    && isValidId(inspectionId)
                    && isValidInspection(incoming())
                    && incoming().inspectedAt == request.time;
                    
      allow update: if isVerified()
                    && isValidId(inspectionId)
                    && isValidInspection(incoming())
                    && (isAdmin() || incoming().inspectedBy == existing().inspectedBy)
                    && incoming().inspectedAt == request.time;
                    
      allow delete: if isAdmin();
    }
  }
}
