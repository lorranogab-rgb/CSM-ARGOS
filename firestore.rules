rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // 1. Core Primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'lorranogab@gmail.com' ||
        request.auth.token.email == 'cbmpr.leilao@gmail.com' ||
        request.auth.uid == 'ohL34Vl1pFRAWcNXbc91EF2V0hP2'
      );
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128;
    }

    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    // 2. Validation Blueprints
    function isValidVehicle(data) {
      return data.keys().hasAll(['placa'])
        && data.placa is string && data.placa.size() <= 128;
    }

    function isValidInspection(data) {
      return data.keys().hasAll(['placa', 'modelo', 'nota', 'class', 'data', 'fullData'])
        && data.placa is string && data.placa.size() <= 128
        && data.modelo is string && data.modelo.size() <= 512
        && data.nota is number
        && data.fullData is map;
    }

    // 3. Collection Rules
    match /vehicles/{vehicleId} {
      allow read: if true;
      allow create, update, delete: if isSignedIn();
    }

    match /inspections/{inspectionId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }
  }
}
